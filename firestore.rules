rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Cada cuenta solo puede acceder a la información de su propio taller.
    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;

      match /appData/{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Se cierran las colecciones antiguas que compartían datos entre usuarios.
    match /services/{document=**} {
      allow read, write: if false;
    }
    match /costs/{document=**} {
      allow read, write: if false;
    }
    match /quotes/{document=**} {
      allow read, write: if false;
    }
    match /settings/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
