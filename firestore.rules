rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return verified() && request.auth.uid == uid
        && (!(request.auth.token.managedAccount == true) || request.auth.token.workshopId == uid);
    }

    function account(uid) {
      return get(/databases/$(database)/documents/accounts/$(uid)).data;
    }

    function accountCanWrite(uid) {
      return isOwner(uid) && (
        (account(uid).status == 'trialing' && account(uid).trialEndsAt > request.time) ||
        (account(uid).status == 'active'
          && ('paidThrough' in account(uid))
          && account(uid).paidThrough > request.time)
      );
    }

    function accountCanRead(uid) {
      return isOwner(uid) && account(uid).status != 'suspended';
    }

    match /accounts/{uid} {
      allow read: if isOwner(uid);
      allow create: if false;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastSeenAt',
          'onboardingCompleted',
          'termsAcceptedAt',
          'privacyAcceptedAt',
          'firstServiceAt'
        ]);
      allow delete: if false;
    }

    match /workshops/{uid} {
      allow read: if accountCanRead(uid);
      allow create: if accountCanWrite(uid) && request.resource.data.ownerUid == uid;
      allow update: if accountCanWrite(uid)
        && resource.data.ownerUid == uid
        && request.resource.data.ownerUid == uid;
      allow delete: if false;

      match /services/{serviceId} {
        allow read: if accountCanRead(uid);
        allow create, update: if accountCanWrite(uid)
          && request.resource.data.id == serviceId;
        allow delete: if accountCanWrite(uid);
      }

      match /costs/{costId} {
        allow read: if accountCanRead(uid);
        allow create, update: if accountCanWrite(uid)
          && request.resource.data.id == costId;
        allow delete: if accountCanWrite(uid);
      }

      match /quotes/{quoteId} {
        allow read: if accountCanRead(uid);
        allow create, update: if accountCanWrite(uid)
          && request.resource.data.id == quoteId;
        allow delete: if accountCanWrite(uid);
      }

      match /activity/{date} {
        allow read: if accountCanRead(uid);
        allow create, update: if accountCanWrite(uid)
          && request.resource.data.date == date;
        allow delete: if accountCanWrite(uid);
      }
    }

    // Ruta anterior conservada temporalmente solo para migrar datos existentes.
    // Se cerrará después de confirmar que todos los talleres fueron migrados.
    match /users/{uid} {
      allow read: if accountCanRead(uid);
      allow create, update: if accountCanWrite(uid);
      allow delete: if isOwner(uid);

      match /appData/{document=**} {
        allow read: if accountCanRead(uid);
        allow write: if accountCanWrite(uid);
      }
    }

    match /services/{document=**} { allow read, write: if false; }
    match /costs/{document=**} { allow read, write: if false; }
    match /quotes/{document=**} { allow read, write: if false; }
    match /settings/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
