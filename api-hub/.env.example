# API Hub — copia estas variables a .env.local / Vercel Environment Variables.
# NUNCA subas claves reales a GitHub.

# BACKEND GESTIÓN TALLER
# ID público del proyecto Firebase usado para validar los ID tokens en las funciones serverless.
FIREBASE_PROJECT_ID=

BITLY_TOKEN=
CLICKMETER_API_KEY=
CLICKMETER_BASE_URL=https://apiv2.clickmeter.com

GEOAPIFY_API_KEY=
MAPBOX_ACCESS_TOKEN=

SCREENSHOTLAYER_ACCESS_KEY=
APIFLASH_ACCESS_KEY=

APITEMPLATE_API_KEY=
PHOTOROOM_API_KEY=
PHOTOROOM_BASE_URL=https://sdk.photoroom.com/v1
TINIFY_API_KEY=

CRAFTMYPDF_API_KEY=
BUILDPDF_API_KEY=
BUILDPDF_BASE_URL=https://api.buildpdf.com

CARVECTOR_API_KEY=
CARVECTOR_BASE_URL=https://api.carvector.com
# Ruta oficial de consulta VIN de tu plan/proveedor. Debe contener literalmente {vin}.
# Se deja vacía para no inventar un endpoint no documentado.
CARVECTOR_VIN_PATH_TEMPLATE=

NUMVERIFY_API_KEY=
MAILBOXLAYER_API_KEY=

AYRSHARE_API_KEY=
POSTLAKE_API_KEY=
POSTLAKE_BASE_URL=https://api.postlake.ai

TICKETMASTER_API_KEY=
EVENTBRITE_TOKEN=
TRIPADVISOR_API_KEY=

# IA / MULTI-LLM — solo backend/serverless. No usar prefijo VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Arles API Hub

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

HF_TOKEN=
HF_MODEL=openai/gpt-oss-120b:fastest

# En Vercel, AI Gateway puede autenticarse automáticamente con VERCEL_OIDC_TOKEN.
# AI_GATEWAY_API_KEY queda como alternativa para local u otros entornos.
AI_GATEWAY_API_KEY=
VERCEL_AI_MODEL=openai/gpt-5.4-mini

CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b
