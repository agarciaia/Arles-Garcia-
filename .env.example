# Gestión Taller — variables de entorno para backend/serverless (Vercel)
#
# Copia únicamente las variables que vayas a usar a Vercel Environment Variables.
# NUNCA escribas claves reales en este archivo ni las expongas mediante VITE_*.
# Las funciones /api/* leen estas variables con process.env únicamente en servidor.

# Firebase (el Project ID no es secreto; permite sobrescribir el valor por defecto)
FIREBASE_PROJECT_ID=gen-lang-client-0518660857

# Voz → texto (necesaria para “Crear por voz”)
GROQ_API_KEY=
GROQ_MODEL=

# Router multi-IA — configura al menos UN proveedor de texto.
# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Cerebras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=

# Fallbacks opcionales
NVIDIA_API_KEY=
NVIDIA_MODEL=
HF_TOKEN=
HF_MODEL=
COHERE_API_KEY=
COHERE_MODEL=
AI_GATEWAY_API_KEY=
VERCEL_AI_MODEL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=

# Vehículos / VIN
CARVECTOR_API_KEY=
CARVECTOR_BASE_URL=https://api.carvector.com
# Debe ser una ruta oficial compatible con tu plan e incluir literalmente {vin}.
# Ejemplo de forma (NO asumir que sea el endpoint de tu cuenta): /ruta/oficial/{vin}
CARVECTOR_VIN_PATH_TEMPLATE=

# Validación de teléfono (herramienta adicional del API Hub)
NUMVERIFY_API_KEY=

# Integraciones opcionales ya contempladas por el API Hub
TINIFY_API_KEY=
CRAFTMYPDF_API_KEY=
