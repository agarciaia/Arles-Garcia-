{
  "entities": {
    "Service": {
      "title": "Service",
      "description": "A service order in the workshop",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientName": { "type": "string" },
        "phone": { "type": "string" },
        "plate": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "reason": { "type": "string" },
        "price": { "type": "number" },
        "entryDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["pending", "in-progress", "completed", "cancelled"] }
      },
      "required": ["id", "clientName", "plate", "entryDate", "status"]
    },
    "Cost": {
      "title": "Cost",
      "description": "A workshop cost or expense",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "category": { "type": "string", "enum": ["parts", "labor", "utilities", "other"] }
      },
      "required": ["id", "description", "amount", "date", "category"]
    },
    "Quote": {
      "title": "Quote",
      "description": "A service quote",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientName": { "type": "string" },
        "total": { "type": "number" },
        "date": { "type": "string", "format": "date" }
      },
      "required": ["id", "clientName", "total", "date"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Application settings",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" }
      },
      "required": ["companyName"]
    },
    "Account": {
      "title": "Account",
      "description": "Trial and subscription state for one authenticated workshop owner",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "plan": { "type": "string", "enum": ["trial", "founder"] },
        "status": { "type": "string", "enum": ["trialing", "active", "past_due", "suspended"] },
        "onboardingCompleted": { "type": "boolean" }
      },
      "required": ["uid", "email", "plan", "status", "onboardingCompleted"]
    }
  },
  "firestore": {
    "/accounts/{uid}": { "schema": { "$ref": "Account" }, "description": "Account lifecycle isolated by UID" },
    "/workshops/{uid}": { "schema": { "$ref": "AppSettings" }, "description": "Workshop settings owned by UID" },
    "/workshops/{uid}/services/{serviceId}": { "schema": { "$ref": "Service" } },
    "/workshops/{uid}/costs/{costId}": { "schema": { "$ref": "Cost" } },
    "/workshops/{uid}/quotes/{quoteId}": { "schema": { "$ref": "Quote" } }
  }
}
